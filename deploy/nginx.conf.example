# =============================================================================
# 迁移到新服务器时用的站点配置参照（2026-10-07 12:12 与线上逐字节一致的快照）
# 用法：拷成 /etc/nginx/sites-available/xxc2007.me → 软链进 sites-enabled → nginx -t → reload
# 需要你自己填的：证书路径（certbot 出来的那份）、GEOHOT 与 Artalk 的端口、以及 webroot 归属。
#
# 先解证书，再挂这份配置——否则第一步就会卡住：:443 那两个 server 里的 ssl_certificate
# 指向的文件不存在时 nginx -t 直接失败；而 certbot 的 webroot 验证又要求 :80 已经在服务。
# 破法是按顺序来，别一上来就整份拷：
#   1) 先只挂一个最小的 :80 server（root 指向介绍站目录 + 留 /.well-known/acme-challenge/），
#      nginx -t && reload，确认 http://域名/ 能打开；
#   2) certbot certonly --webroot ... 拿到证书；
#   3) 再整份替换成下面这一份，nginx -t && reload。
#   （证书路径本身不是秘密：/etc/letsencrypt/live/<域名>/privkey.pem 这种写法可以留在仓库里，
#     私钥内容不在里面。check-links 对这条开了口子。）
#
# 归属：介绍站拿 / 、/en/ 、/assets/ 、/404.html 、/favicon.ico ；
#       /nc15/ 是纪念册（alias /var/www/nc15/），/geohot 反代 :3000，/comment/ 反代 :23366。
# /comment/ 为什么必须在域名根：纪念册的 wall.js 用根绝对路径请求 Artalk API，
#   而既有留言的 page_key 是 /guestbook——那是数据库里的键、不是网址，搬走等于把留言墙清空。
#
# 三条实测过的规则：add_header 不被子 location 继承；error_page 404 必须写 =404；
#   Cloudflare 明文回源所以要 absolute_redirect off，访客侧强制 https 交给 CF 的 Always Use HTTPS。
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name www.xxc2007.me;
    return 301 https://xxc2007.me$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.xxc2007.me;

    ssl_certificate     /etc/letsencrypt/live/xxc2007.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xxc2007.me/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    return 301 https://xxc2007.me$request_uri;
}

# ---- 裸域 · HTTP（保留直服务，防 CF Flexible 回源被重定向循环） ----
server {
    listen 80;
    listen [::]:80;
    server_name xxc2007.me;
    absolute_redirect off;

    root /var/www/intro;
    index index.html;
    charset utf-8;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 介绍站自己的 CSP。三条注意：
    #  ① add_header 不被子 location 继承——凡是下面自己写了 add_header 的 location，
    #     必须把这四行原样再抄一遍，否则那几条响应头会整体消失（不是叠加，是替换）。
    #     所以这两行在多数 location 里其实是死的，留着只为兜住没有自带 add_header 的路径。
    #  ② style-src 需要 'unsafe-inline'：两页各有一个 <noscript><style> 兜底块，
    #     去掉它会把无脚本降级路径一起打死。script-src 保持严格 'self'——
    #     全站零内联脚本（唯一的 <script type="application/ld+json"> 是数据不是代码，CSP 不管它），
    #     Cloudflare 注入的 email-decode.min.js 走 /cdn-cgi/... 属同源，'self' 已经放行。
    #  ③ 这一份只给介绍站。**不要**把它抄到 /geohot 或 /nc15 的 location 里：
    #     那两个站各自的脚本与样式来源不同，套同一份 CSP 会直接把页面打死。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    error_page 404 /404.html;
    # /index.html 直接访问收口到 /：canonical 与 sitemap 都只写 /，两个 URL 都回 200 就是重复内容。
    # 用 $request_uri 判原始请求，不能用 location = /index.html { return 301 /; }——
    # index 模块会把 / 内部重定向到 /index.html，而内部重定向同样重新匹配 location，那样就成了循环。
    if ($request_uri = /index.html) { return 301 /; }
    if ($request_uri = /en/index.html) { return 301 /en/; }

    # HTML/robots/sitemap 永远回源校验（配 ETag 命中 304）——杜绝浏览器启发式缓存吃掉新版页面/脚本
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /robots.txt  {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /sitemap.xml {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
    }

    # giscus 自定义主题：允许 giscus.app 跨域加载（保留，防止回退使用）
    location = /giscus-theme.css {
        add_header Access-Control-Allow-Origin "https://giscus.app" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # Artalk 留言服务反代（本机 127.0.0.1:23366）
    # ^~ 必须保留：阻止下方静态资源正则截胡 /comment/static/images/*.jpg（留言头像）
    location ^~ /comment/ {
        proxy_pass http://127.0.0.1:23366/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2m;
    }

    # 静态资源长缓存：页面用 ?v= 版本号；照片/字体内容不变更，换内容请换文件名
    location ~* \.(css|js|mjs|map|woff2?|ttf|otf|png|jpe?g|gif|svg|ico|webp|avif)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # 纪念册迁到 /nc15/：站内绝对路径已带 /nc15 前缀；/comment/ 与 /geohot/ 留在域名根

    # 仓库内部文件类型不对公网开放（曾经 assets/images/README.md 随 assets 一起发布过）。
    # 这里只影响介绍站：^~ 前缀的 /nc15/、/geohot、/comment/ 优先级比正则高，不会被这条抓到。
    location ~* \.(md|markdown|sh|conf|bak|example|env)$ {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        return 404;
    }

    # 浏览器与各种机器人默认打的是根上的 /favicon.ico，而本站的图标在 assets/images/ 下。
    location = /favicon.ico {
        alias /var/www/intro/assets/images/favicon.ico;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    if ($request_uri = /nc15/index.html) { return 301 /nc15/; }
    # —— 纪念册迁到 /nc15/ ——
    # 站内绝对路径已带 /nc15 前缀；/comment/（Artalk）与 /geohot/ 刻意留在域名根。
    # 旧路径（域名根时代）用 301 收敛到 /nc15/：内部改写会让同一页面在两个 URL 上都是 200，
    # 属于重复内容且不指向规范链接。/en/ 与 /assets/ 已归介绍站，所以不在名单里。
    rewrite ^/(zh-Hant|ja|ko|ru|es|fr|pt|ar|promo|images|maplibre|data)(/.*)?$ /nc15/$1$2 permanent;

    # 介绍站自身的 HTML 每次回源校验：/en/ 与 /404.html 此前没有 Cache-Control，
    # 浏览器按启发式缓存，改版后老访客会长期看到旧页面。/404.html 收为 internal：
    # 直接访问它不再回一个 200 的「假页面」，只允许 error_page 内部命中。
    location = /en/index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # /nc15/ 的 HTML 此前完全没有 Cache-Control。nginx 的 add_header 不被子 location 继承
    # ——父层一声明，子层就得把安全头整套重抄，否则子层响应反而丢头。
    location ^~ /nc15/ {
        alias /var/www/nc15/;
        index index.html;
        try_files $uri $uri/ =404;
        error_page 404 =404 /nc15/404.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        location ~* \.(css|js|mjs|map|woff2?|ttf|otf|mp4|m4a|ogg|png|jpe?g|gif|svg|ico|webp|avif)$ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        }
    }
    # robots/sitemap/404 用顶层精确 location：精确匹配优先于上面的 ^~ 前缀，
    # 且不嵌进 alias 块里——alias 下再套子 location 是 nginx 的已知坑。
    location = /nc15/robots.txt {
        alias /var/www/nc15/robots.txt;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /nc15/sitemap.xml {
        alias /var/www/nc15/sitemap.xml;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    location = /nc15/404.html {
        internal;
        alias /var/www/nc15/404.html;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /nc15 { return 308 https://$host/nc15/; }

    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript image/svg+xml application/json;

# ---- ADD: GEOHOT 反代（/geohot/ 子路径）----
# 不剥前缀：应用构建时带 BASE_PATH=/geohot 并自行归一化入站路径，故原样转发。
# 裸路径补斜杠：客户端路由的 basename 是 /geohot，裸路径在浏览器里解析不到首页。
# 目标写死 https，不要用相对路径——相对 Location 按连接协议拼接，而 Cloudflare 是明文回源。
location = /geohot {
    return 308 https://$host/geohot/;
}

location ^~ /geohot {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    client_max_body_size 10m;
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
}

location ^~ /geohot/api/mcp {
    proxy_pass http://127.0.0.1:3000/geohot/api/mcp;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_buffering    off;
    proxy_cache        off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    chunked_transfer_encoding on;
    client_max_body_size 1m;
}

}

# ---- 裸域 · HTTPS ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xxc2007.me;

    root /var/www/intro;
    index index.html;
    charset utf-8;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/xxc2007.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xxc2007.me/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    error_page 404 /404.html;
    # /index.html 直接访问收口到 /：canonical 与 sitemap 都只写 /，两个 URL 都回 200 就是重复内容。
    # 用 $request_uri 判原始请求，不能用 location = /index.html { return 301 /; }——
    # index 模块会把 / 内部重定向到 /index.html，而内部重定向同样重新匹配 location，那样就成了循环。
    if ($request_uri = /index.html) { return 301 /; }
    if ($request_uri = /en/index.html) { return 301 /en/; }

    # HTML/robots/sitemap 永远回源校验（配 ETag 命中 304）——杜绝浏览器启发式缓存吃掉新版页面/脚本
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /robots.txt  {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /sitemap.xml {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
    }

    # giscus 自定义主题：允许 giscus.app 跨域加载（保留，防止回退使用）
    location = /giscus-theme.css {
        add_header Access-Control-Allow-Origin "https://giscus.app" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # Artalk 留言服务反代（本机 127.0.0.1:23366）
    # ^~ 必须保留：阻止下方静态资源正则截胡 /comment/static/images/*.jpg（留言头像）
    location ^~ /comment/ {
        proxy_pass http://127.0.0.1:23366/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2m;
    }

    # 静态资源长缓存：页面用 ?v= 版本号；照片/字体内容不变更，换内容请换文件名
    location ~* \.(css|js|mjs|map|woff2?|ttf|otf|png|jpe?g|gif|svg|ico|webp|avif)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # 纪念册迁到 /nc15/：站内绝对路径已带 /nc15 前缀；/comment/ 与 /geohot/ 留在域名根

    # 仓库内部文件类型不对公网开放（曾经 assets/images/README.md 随 assets 一起发布过）。
    # 这里只影响介绍站：^~ 前缀的 /nc15/、/geohot、/comment/ 优先级比正则高，不会被这条抓到。
    location ~* \.(md|markdown|sh|conf|bak|example|env)$ {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 404;
    }

    # 浏览器与各种机器人默认打的是根上的 /favicon.ico，而本站的图标在 assets/images/ 下。
    location = /favicon.ico {
        alias /var/www/intro/assets/images/favicon.ico;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    if ($request_uri = /nc15/index.html) { return 301 /nc15/; }
    # —— 纪念册迁到 /nc15/ ——
    # 站内绝对路径已带 /nc15 前缀；/comment/（Artalk）与 /geohot/ 刻意留在域名根。
    # 旧路径（域名根时代）用 301 收敛到 /nc15/：内部改写会让同一页面在两个 URL 上都是 200，
    # 属于重复内容且不指向规范链接。/en/ 与 /assets/ 已归介绍站，所以不在名单里。
    rewrite ^/(zh-Hant|ja|ko|ru|es|fr|pt|ar|promo|images|maplibre|data)(/.*)?$ /nc15/$1$2 permanent;

    # 介绍站自身的 HTML 每次回源校验：/en/ 与 /404.html 此前没有 Cache-Control，
    # 浏览器按启发式缓存，改版后老访客会长期看到旧页面。/404.html 收为 internal：
    # 直接访问它不再回一个 200 的「假页面」，只允许 error_page 内部命中。
    location = /en/index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # /nc15/ 的 HTML 此前完全没有 Cache-Control。nginx 的 add_header 不被子 location 继承
    # ——父层一声明，子层就得把安全头整套重抄，否则子层响应反而丢头。
    location ^~ /nc15/ {
        alias /var/www/nc15/;
        index index.html;
        try_files $uri $uri/ =404;
        error_page 404 =404 /nc15/404.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;

        location ~* \.(css|js|mjs|map|woff2?|ttf|otf|mp4|m4a|ogg|png|jpe?g|gif|svg|ico|webp|avif)$ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        }
    }
    # robots/sitemap/404 用顶层精确 location：精确匹配优先于上面的 ^~ 前缀，
    # 且不嵌进 alias 块里——alias 下再套子 location 是 nginx 的已知坑。
    location = /nc15/robots.txt {
        alias /var/www/nc15/robots.txt;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /nc15/sitemap.xml {
        alias /var/www/nc15/sitemap.xml;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /nc15/404.html {
        internal;
        alias /var/www/nc15/404.html;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location = /nc15 { return 308 https://$host/nc15/; }

    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript image/svg+xml application/json;

# ---- ADD: GEOHOT 反代（/geohot/ 子路径）----
# 不剥前缀：应用构建时带 BASE_PATH=/geohot 并自行归一化入站路径，故原样转发。
location ^~ /geohot/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    client_max_body_size 10m;
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
}

location ^~ /geohot/api/mcp {
    proxy_pass http://127.0.0.1:3000/geohot/api/mcp;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_buffering    off;
    proxy_cache        off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    chunked_transfer_encoding on;
    client_max_body_size 1m;
}

}
