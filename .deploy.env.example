# 部署目标（复制为 .deploy.env 后填写；.deploy.env 已被 .gitignore 排除，绝不入库）
DEPLOY_HOST=<server-ip>
DEPLOY_USER=<ssh-user>
DEPLOY_KEY=~/.ssh/<your-key>.pem
# 站点在服务器上的物理目录
DEPLOY_ROOT=/var/www/intro
# nginx server_name 与对外地址
DEPLOY_SITE=xxc2007.me
SITE_URL=https://xxc2007.me
# 中文用户名环境下 OpenSSH 会转义 known_hosts 路径，可指向 ASCII 路径
# DEPLOY_KNOWN_HOSTS=/d/tmp/kh
